# =============================================================================
# Настройки деплоя EcoLeadBot на VPS
# Скопируйте в deploy/deploy.config.env и заполните только строки с «ВАШ_...»
# =============================================================================

# IP-адрес VPS (из письма хостера или панели «Серверы»).
# Пример: 185.12.34.56
# Если n8n на том же сервере — тот же IP, что у n8n.ecolusspb.ru
ECOBOT_SSH_HOST=ВАШ_IP

# Логин SSH. Обычно: root  или  ubuntu  (смотрите письмо при создании VPS)
ECOBOT_SSH_USER=root

# Порт SSH. Почти всегда 22 — менять не нужно, если хостер не писал другой.
ECOBOT_SSH_PORT=22

# Папка на сервере, куда положим проект. Это НЕ «готовый путь из панели» —
# мы сами создаём эту папку при первом деплое. Можно оставить как есть.
ECOBOT_REMOTE_DIR=/opt/ecoleadbot

# Поддомен с SSL (DNS A-запись → IP VPS). После деплоя nginx настроит HTTPS.
ECOBOT_DOMAIN=elb.ecolusspb.ru

# Опционально: пароль SSH (файл gitignored). Без него — ssh/scp спросят пароль вручную
# или запуск: deploy/deploy.ps1 -PromptPassword
# ECOBOT_SSH_PASSWORD=ваш_пароль_root
