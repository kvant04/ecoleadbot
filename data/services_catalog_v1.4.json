  "ux_rules": {
    "document_branch_prefill": [
      "activity_type",
      "sites_count"
    ],
    "activity_type_note": "В ветке «конкретная услуга» вид деятельности подставляется из основного сценария, если пользователь уже прошёл его. Иначе — тот же список, что на экране «Вид деятельности».",
    "waste_classes_note": "Отходы 5 класса — паспорта не нужны. Отходы 1–4 класса — паспорта обязательны.",
    "service_gates_v1": {
      "description": "Стоп-экраны без заявки в CRM; события GTM disqualified_* — см. app.js evaluateServiceGate",
      "gates": [
        {
          "service_id": "pdv-ndv",
          "condition": "nvos_category = IV",
          "gtm_event": "disqualified_pdv_ndv_iv"
        },
        {
          "service_id": "pnool",
          "condition": "nvos_category in III, IV",
          "gtm_event": "disqualified_pnool_iii_iv"
        },
        {
          "service_id": "zso",
          "condition": "zso_water_source = Поверхностный водозабор",
          "gtm_event": "disqualified_zso_surface"
        },
        {
          "service_id": "deklaraciya-stochnyh-vod",
          "condition": "dsv_discharge_point = Собственный водный объект",
          "gtm_event": "disqualified_dsv_not_csv"
        }
      ],
      "exceptions": [
        "zso: Комбинированный источник — без автостопа"
      ]
