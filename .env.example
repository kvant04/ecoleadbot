# OpenAI — EcoLeadBot RAG
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_VECTOR_STORE_ID=vs_your-vector-store-id
OPENAI_MODEL=gpt-4.1-mini

# Сервер (server.py)
# HOST=127.0.0.1
# PORT=8000

# CORS — через запятую, без пробелов вокруг * (не используйте * в проде)
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://elb.ecolusspb.ru,https://ecolusspb.ru,https://www.ecolusspb.ru

# Лимит RAG: запросов на IP и на session_id за окно (сек)
# RAG_RATE_LIMIT=20
# RAG_RATE_WINDOW_SEC=60

# Опционально: если OpenAI API недоступен из региона (403 unsupported_country_region_territory)
# HTTPS_PROXY=http://user:pass@host:port
# OPENAI_PROXY=http://user:pass@host:port
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- n8n / Bitrix (не для server.py; задайте в окружении n8n и в elb-config) ---
# BITRIX_WEBHOOK_URL=https://YOUR_BITRIX_HOST/rest/1/YOUR_TOKEN/crm.lead.add.json
# ECOLEADBOT_WEBHOOK_SECRET=generate-a-long-random-string

# --- Аналитика: еженедельная сводка (блок F2) ---
# OAuth-токен Яндекс.Метрики (право metrika:read), получить на oauth.yandex.ru
# YANDEX_METRIKA_TOKEN=
# Номер счётчика Яндекс.Метрики для отчёта
# YANDEX_METRIKA_COUNTER_ID=
# SMTP для отправки еженедельного письма-сводки
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Получатели отчёта, через запятую
# METRIKA_REPORT_RECIPIENTS=kvant04@mail.ru,marketolog@ecolusspb.ru
# METRIKA_REPORT_WEEKDAY=0
# METRIKA_REPORT_HOUR=9

# Corporate cycles: dates in data/corporate_cycles.json; state in data/metrika_report_state.json.
# METRIKA_CYCLE_ANCHOR_START=2026-07-17
# METRIKA_CYCLE_DAYS=28
# METRIKA_CYCLES_PER_QUARTER=3
# METRIKA_CYCLE_REPORT_HOUR=9
# Optional; when empty, METRIKA_REPORT_RECIPIENTS is used.
# METRIKA_CYCLE_RECIPIENTS=
